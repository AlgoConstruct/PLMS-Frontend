{
  "extends": "@pathwayiq/config/tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@pathwayiq/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@pathwayiq/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@pathwayiq/api/*": [
        "../../packages/api/src/*"
      ],
      "@pathwayiq/access/*": [
        "../../packages/access/src/*"
      ],
      "@pathwayiq/feature-iam-admin/*": [
        "../../packages/feature-iam-admin/src/*"
      ],
      "@pathwayiq/feature-learning/*": [
        "../../packages/feature-learning/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/*/src/**/*.ts",
    "../../packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
