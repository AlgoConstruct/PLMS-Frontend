{
  "name": "pathwayiq-frontend",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "eslint .",
    "api:generate": "pnpm --filter @pathwayiq/api generate",
    "e2e": "pnpm --filter @pathwayiq/app e2e",
    "e2e:platform": "pnpm --filter @pathwayiq/app e2e:platform",
    "e2e:shell": "pnpm --filter @pathwayiq/app e2e:shell",
    "e2e:projects": "pnpm --filter @pathwayiq/app e2e:projects"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "turbo": "^2"
  }
}
